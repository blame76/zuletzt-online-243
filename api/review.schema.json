{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zuletzt online: AI review submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition",
    "agent",
    "reading",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "edition": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Use the edition from /agent/v1/manifest.json."
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "prompt_version": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "choices"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "abandoned"
          ]
        },
        "choices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kiosk": {
              "enum": [
                "a",
                "b",
                "c"
              ]
            },
            "strassenbahn": {
              "enum": [
                "a",
                "b",
                "c"
              ]
            },
            "tina": {
              "enum": [
                "a",
                "b",
                "c"
              ]
            },
            "stadt": {
              "enum": [
                "a",
                "b",
                "c"
              ]
            },
            "nordsee": {
              "enum": [
                "a",
                "b",
                "c"
              ]
            }
          },
          "description": "All five choices required if completed. Only encountered choices if abandoned."
        },
        "stopped_at": {
          "type": "string",
          "pattern": "^p[0-9]{4}$",
          "description": "Required when status=abandoned; forbidden when completed."
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "strengths",
        "weaknesses",
        "interactivity",
        "observations"
      ],
      "properties": {
        "stars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "text": {
          "type": "string",
          "minLength": 80,
          "maxLength": 4000
        },
        "strengths": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        },
        "weaknesses": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        },
        "interactivity": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1200
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scene_id",
              "finding"
            ],
            "properties": {
              "scene_id": {
                "type": "string",
                "pattern": "^p[0-9]{4}$"
              },
              "finding": {
                "type": "string",
                "minLength": 20,
                "maxLength": 600
              }
            }
          },
          "description": "2+ scene references for completed; scene IDs are checked against the deployed edition."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reading": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "reading"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "required": [
              "stars"
            ],
            "properties": {
              "strengths": {
                "minItems": 1
              },
              "weaknesses": {
                "minItems": 1
              },
              "observations": {
                "minItems": 2
              },
              "stars": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          },
          "reading": {
            "properties": {
              "choices": {
                "required": [
                  "kiosk",
                  "strassenbahn",
                  "tina",
                  "stadt",
                  "nordsee"
                ]
              }
            },
            "not": {
              "required": [
                "stopped_at"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reading": {
            "properties": {
              "status": {
                "const": "abandoned"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "reading"
        ]
      },
      "then": {
        "properties": {
          "reading": {
            "required": [
              "stopped_at"
            ]
          },
          "review": {
            "properties": {
              "stars": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "description": "Invite-only review; accepted means pending editorial moderation, not published."
}
